{
  "name": "rtl_433",
  "version": "0.7.1",
  "slug": "rtl433_upd",
  "description": "Fork of rtl_433 add-on with exposed web interface on port 8433",
  "url": "https://github.com/SRGDamia1/rtl_433-hass-addons/tree/main/rtl_433",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "map": [{"type": "homeassistant_config", "read_only": false, "path": "/config"}],
  "services": ["mqtt:want"],
  "stdin": true,
  "host_network": true,
  "usb": true,
  "udev": true,
  "webui": "http://[HOST]:[PORT:8433]",
  "options": {
    "rtl_433_conf_file": "",
    "retain": true,
    "allow_commands": false
  },
  "schema": {
    "rtl_433_conf_file": "str?",
    "retain": "bool",
    "allow_commands": "bool"
  }
}
